rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.role == 'admin'; }
    function instructor() { return signedIn() && (request.auth.token.role == 'admin' || request.auth.token.role == 'instructor'); }
    function owns(userId) { return signedIn() && request.auth.uid == userId; }
    function teaches(courseId) { return instructor() && get(/databases/$(database)/documents/courses/$(courseId)).data.instructorId == request.auth.uid; }
    // getAfter supports a course import batch that creates a course and its content together.
    function teachesAfter(courseId) { return instructor() && getAfter(/databases/$(database)/documents/courses/$(courseId)).data.instructorId == request.auth.uid; }
    function enrolled(courseId) { return signedIn() && exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId)); }

    // Profile documents are not authority. Custom claims are assigned only by Admin SDK.
    match /users/{userId} {
      allow get: if owns(userId) || admin();
      allow create: if owns(userId) && !('role' in request.resource.data);
      allow update: if (owns(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) || admin();
      allow delete: if admin();
    }

    match /courses/{courseId} {
      // Authentication is required because legacy course documents can contain embedded quizzes.
      allow read: if signedIn();
      allow create: if instructor() && request.resource.data.instructorId == request.auth.uid;
      allow update: if admin() || teaches(courseId) || (
        enrolled(courseId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrolled', 'updatedAt'])
        && (request.resource.data.enrolled == resource.data.enrolled + 1 || request.resource.data.enrolled == resource.data.enrolled - 1)
      );
      allow delete: if admin();
    }

    match /lessons/{lessonId} {
      allow read: if enrolled(resource.data.courseId) || teaches(resource.data.courseId) || admin();
      allow create: if instructor() && teachesAfter(request.resource.data.courseId);
      allow update, delete: if teaches(resource.data.courseId) || admin();
    }

    // Quiz documents contain answer keys and are never readable by learners.
    match /quizzes/{quizId} {
      allow read: if admin() || teaches(resource.data.courseId);
      allow create: if instructor() && request.resource.data.createdBy == request.auth.uid && teachesAfter(request.resource.data.courseId);
      allow update, delete: if admin() || teaches(resource.data.courseId);
    }

    // Callable Functions are the sole author/grader. Learners can only read their own result.
    match /quiz-attempts/{attemptId} {
      allow read: if owns(resource.data.userId) || admin() || teaches(resource.data.courseId);
      allow create, update, delete: if false;
    }

    match /enrollments/{enrollmentId} {
      allow read: if owns(resource.data.userId) || admin() || teaches(resource.data.courseId);
      allow create: if owns(request.resource.data.userId)
        && enrollmentId == request.auth.uid + '_' + request.resource.data.courseId
        && exists(/databases/$(database)/documents/courses/$(request.resource.data.courseId));
      allow update: if admin() || teaches(resource.data.courseId);
      allow delete: if admin();
    }

    match /courseProgress/{progressId} {
      allow read: if owns(resource.data.userId) || admin() || teaches(resource.data.courseId);
      allow create, update: if owns(request.resource.data.userId);
      allow delete: if admin();
    }

    match /notes/{noteId} { allow read, create, update, delete: if owns(resource.data.userId); }
    match /bookmarks/{bookmarkId} { allow read, create, update, delete: if owns(resource.data.userId); }
    match /highlights/{highlightId} { allow read, create, update, delete: if owns(resource.data.userId); }
    match /readingPositions/{positionId} { allow read, create, update, delete: if owns(resource.data.userId); }
    match /achievements/{achievementId} { allow read: if owns(resource.data.userId) || admin(); allow write: if admin(); }
    match /analytics/{document=**} { allow read, write: if admin(); }
    match /notifications/{notificationId} { allow read: if owns(resource.data.userId) || admin(); allow create, delete: if admin(); allow update: if owns(resource.data.userId) || admin(); }
    match /{document=**} { allow read, write: if false; }
  }

    match /assignments/{assignmentId} {
      allow read: if signedIn() && (enrolled(resource.data.courseId) || teaches(resource.data.courseId) || admin());
      allow create: if instructor() && request.resource.data.createdBy == request.auth.uid && teachesAfter(request.resource.data.courseId);
      allow update, delete: if admin() || teaches(resource.data.courseId);
    }

    match /assignmentSubmissions/{submissionId} {
      allow read: if owns(resource.data.userId) || admin() || teaches(resource.data.courseId);
      allow create, update, delete: if false;
    }
    match /gradeConfigs/{courseId} { allow read: if signedIn() && (enrolled(courseId) || teaches(courseId) || admin()); allow write: if admin() || teaches(courseId); }
    match /finalResults/{resultId} { allow read: if owns(resource.data.userId) || admin() || teaches(resource.data.courseId); allow write: if false; }

  match /academicTerms/{termId} {
    allow read: if signedIn();
    allow create, update: if admin() || (signedIn() && request.auth.token.role == 'instructor');
    allow delete: if admin();
  }
}
