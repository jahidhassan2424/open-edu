{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci && npm --prefix functions ci",
  "buildCommand": "npm --prefix functions run build && node -e \"const fs=require('fs');fs.mkdirSync('public',{recursive:true});fs.writeFileSync('public/index.html','Open-EDU API')\"",
  "outputDirectory": "public",
  "functions": {
    "api/mongo.mjs": {
      "includeFiles": "{netlify/functions/**,functions/lib/**}",
      "maxDuration": 30
    },
    "api/reminders.mjs": {
      "includeFiles": "{netlify/functions/**,functions/lib/**}",
      "maxDuration": 30
    }
  },
  "crons": [{ "path": "/api/reminders", "schedule": "0 * * * *" }]
}
