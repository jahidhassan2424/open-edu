{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci && npm --prefix functions ci",
  "buildCommand": "npm --prefix functions run build",
  "functions": {
    "api/mongo.mjs": {
      "includeFiles": "{netlify/functions/**,functions/lib/**}",
      "maxDuration": 30
    }
  }
}
